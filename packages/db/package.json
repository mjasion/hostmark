{
  "name": "@hostmark/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
