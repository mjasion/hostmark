    "seed": "node --import tsx src/cli/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "4.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "@hostmark/contract": "workspace:*",
    "@neondatabase/serverless": "1.2.0"
  }
}
