{
  "name": "hostmark",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && pnpm typecheck:load",
    "typecheck:load": "tsc -p load/playwright --noEmit",
    "test": "vitest run && pnpm test:load && pnpm test:platform && pnpm test:pipeline",
    "test:load": "node --test load/test/*.test.mjs",
    "test:platform": "node --test tools/platform/*.test.mjs tools/deps/*.test.mjs",
    "test:pipeline": "node --test adapters/cloudflare/pipeline/test/*.test.mjs",
    "platform": "node tools/platform/cli.mjs",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.19.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
