    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@vercel/functions": "3.11.0",
    "@vercel/queue": "0.11.0",
    "hono": "4.13.17",
