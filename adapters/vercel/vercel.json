{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "node --import tsx scripts/build.ts",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/wasm/*.wasm"
    },
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/queue.js": {
      "maxDuration": 300,
      "includeFiles": "dist/wasm/*.wasm",
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "image-jobs",
          "retryAfterSeconds": 30,
          "maxDeliveries": 8
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=requeue-stuck",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron?job=cleanup-expired",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron?job=daily-stats",
      "schedule": "5 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/((?!cron$|queue$).*)",
      "destination": "/api/index"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/f/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?:login|signup)/?|app(?:/.*)?)",
      "destination": "/app/index.html"
    },
    {
      "source": "/pricing{/}?",
      "destination": "/pricing/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
