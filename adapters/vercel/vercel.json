{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npx --yes pnpm@12.16.1 install --frozen-lockfile",
  "buildCommand": "node --import tsx scripts/build.ts",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 90,
      "includeFiles": "dist/wasm/*.wasm"
    },
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/queue.js": {
      "maxDuration": 300,
      "maxConcurrency": 1,
      "includeFiles": "dist/wasm/*.wasm",
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "image-jobs",
          "retryAfterSeconds": 30,
          "maxDeliveries": 8
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/requeue-stuck",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cleanup-expired",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-stats",
      "schedule": "5 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron/:job",
      "destination": "/api/cron?job=:job"
    },
    {
      "source": "/api/((?!cron(?:/|$)|queue$).*)",
      "destination": "/api/index"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/f/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?:login|signup)/?|app(?:/.*)?)",
      "destination": "/app/index.html"
    },
    {
      "source": "/pricing{/}?",
      "destination": "/pricing/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api(?:/|$)|media/|f/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/((?:login|signup|pricing)/?|app(?:/.*)?|(?:pricing/)?index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/rum\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
