# Local-only values for the docker compose stack. Copy to .env (gitignored) before `docker compose up`.
# Nothing here is a real secret: the stack is bound to 127.0.0.1.

POSTGRES_USER=hostmark
POSTGRES_PASSWORD=hostmark-local
POSTGRES_DB=hostmark

MINIO_ROOT_USER=hostmark
MINIO_ROOT_PASSWORD=hostmark-local-secret
S3_BUCKET=hostmark

# Seed API keys (D14). Any string works; the database stores only the SHA-256.
SEED_API_KEY=hm_local_user_key_replace_me_0000000000000000000000000000
SEED_ADMIN_API_KEY=hm_local_admin_key_replace_me_00000000000000000000000000

# Multiplies retry delays (10, 30, 90, 270 s). Leave at 1; the smoke test lowers it for its chaos run.
QUEUE_BACKOFF_SCALE=1
# One job per process: the codecs share one JS thread (D97). Throughput scales with WORKER_REPLICAS (default 2).
WORKER_CONCURRENCY=1
WORKER_REPLICAS=2
APP_VERSION=local

# Cookie sessions (D80). A placeholder for the local stack only; 32+ characters, change it for anything shared.
BETTER_AUTH_SECRET=hm_local_auth_secret_replace_me_000000000000000000000000
# The origin the browser uses. Also the base of the absolute links in /f/:id (D82).
PUBLIC_URL=http://127.0.0.1:58080
AUTH_SIGNUP_ENABLED=true
