# Placeholders only. Copy to .env on the server and replace every value; the file is gitignored.

# DNS names that point at the server (A/AAAA records). Caddy requests certificates for both.
APP_DOMAIN=hostmark.example.com
S3_DOMAIN=s3.hostmark.example.com

# The shared Neon database of the portable variants (D71). Any Postgres connection string works.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The root pair administers MinIO and is used only by minio-user and minio-init. The app signs with its own user,
# limited to S3_BUCKET (D287); its name must differ from the root user.
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-with-a-long-random-string
MINIO_APP_USER=replace-me-too
MINIO_APP_PASSWORD=replace-with-another-long-random-string
S3_BUCKET=hostmark

SEED_API_KEY=replace-with-a-random-key
SEED_ADMIN_API_KEY=replace-with-another-random-key
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
PUBLIC_URL=https://hostmark.example.com
AUTH_SIGNUP_ENABLED=true

# Optional. OTLP/HTTP base URL of the collector; empty turns telemetry export off.
OTLP_ENDPOINT=
WORKER_REPLICAS=2
WORKER_MEM_LIMIT=4g
APP_VERSION=dev
